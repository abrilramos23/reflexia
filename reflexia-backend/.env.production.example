# Required production values. Do not commit real secrets.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=api.reflexia.example.com
FRONTEND_URL=https://reflexia.example.com

# Database
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=reflexiadb
DB_USER=reflexia
DB_PASSWORD=replace-with-a-strong-password

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://reflexia.example.com
CSRF_TRUSTED_ORIGINS=https://reflexia.example.com

# HTTPS / browser security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
USE_X_FORWARDED_PROTO=True
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini

# Email provider
DEFAULT_FROM_EMAIL=no-reply@reflexia.example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Celery / Redis
CELERY_BROKER_URL=redis://redis.example.internal:6379/0
CELERY_RESULT_BACKEND=redis://redis.example.internal:6379/0
